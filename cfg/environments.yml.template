# ============================================================================
# Environments - auswaehlbare Metadaten-Umgebungen (Web-UI Umgebungs-Switch)
# ============================================================================
# Kopieren nach environments.yml und Zugangsdaten je Umgebung anpassen.
# host/user/password sind PRO Environment ueberschreibbar (koennen also auf
# unterschiedlichen Teradata-Servern liegen). "schema" ist die META-DB
# (dort liegen META_TABLE, META_COLUMN, META_ETL_JOB, ...).
# Optional "dashboards": Ablage der Dashboard-Definitionen fuer diese Umgebung
# (relativ zu install_root oder absolut), z. B. '../<kunde>-lakehouse/dashboards'.
# Ohne Angabe gilt paths.dashboards aus config.yml (neutrales Beispiel).
# Optional "dashboards_db": eigene Lese-Verbindung fuer die Fachdaten der
# Dashboards (user, password, optional host), z. B. ein User mit Konsumenten-
# Leserolle auf der ACCESS-Datenbank. Ohne Angabe lesen die Dashboards mit
# user/password der Umgebung.
# Optional "einspielen_db": eigener User (user, password, optional host) für
# tools/paket/einspielen.py - Rollen, GRANTs und DDL brauchen meist mehr Rechte
# als der Betriebs-User. Ohne Angabe spielt der Einspieler mit user/password ein.
# Reihenfolge = Reihenfolge in der Auswahlliste. Beispiel mit zwei Standorten:
#   INT - …  Kunden-Umgebung (z. B. airgapped, von der Entwicklung aus nicht
#            erreichbar; Zugangsdaten dort pflegen)
#   XTD - …  externe Entwicklungsumgebung
# ============================================================================

environments:
  - id: int_sem_dev
    label: "INT - SEM_DEV (Airgapped Remote)"
    host: '<int-host>'
    user: '<user>'
    password: '<passwort>'
    schema: 'SEM_DEV_MET_BASE'
    dashboards: '../<kunde>-lakehouse/dashboards'

  - id: int_sem_dev01
    label: "INT - SEM_DEV01 (Airgapped Remote)"
    host: '<int-host>'
    user: '<user>'
    password: '<passwort>'
    schema: 'SEM_DEV01_MET_BASE'
    dashboards: '../<kunde>-lakehouse/dashboards'

  - id: int_mdp01
    label: "INT - MDP01 (Airgapped Remote)"
    host: '<int-host>'
    user: '<user>'
    password: '<passwort>'
    schema: 'MDP01_META'

  - id: sem_dev
    label: "XTD - SEM_DEV (Extern DEV)"
    host: '<dev-host>'
    user: '<user>'
    password: '<passwort>'
    schema: 'SEM_DEV_MET_BASE'
    dashboards: '../<kunde>-lakehouse/dashboards'
    dashboards_db:
      user: '<lese-user>'
      password: '<passwort>'

  - id: sem_dev01
    label: "XTD - SEM_DEV01 (Extern DEV)"
    host: '<dev-host>'
    user: '<user>'
    password: '<passwort>'
    schema: 'SEM_DEV01_MET_BASE'
    dashboards: '../<kunde>-lakehouse/dashboards'

  - id: mdp01
    label: "XTD - MDP01 (Extern DEV)"
    host: '<dev-host>'
    user: '<user>'
    password: '<passwort>'
    schema: 'MDP01_META'

  - id: sem_tst
    label: "XTD - SEM_TST (Extern DEV)"
    host: '<dev-host>'
    user: '<user>'
    password: '<passwort>'
    schema: 'SEM_TST_MET_BASE'
    dashboards: '../<kunde>-lakehouse/dashboards'

# Environment-ID, die verwendet wird, wenn das Frontend keinen (oder einen
# unbekannten) X-Env-Id-Header schickt.
default: sem_dev
