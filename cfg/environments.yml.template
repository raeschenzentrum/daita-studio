    label: "MDP01 (Produktiv-Meta)"
    host: '192.168.114.21'
    user: 'tdops'
    password: 'tdops'
    schema: 'MDP01_META'

  - id: sem_dev
    label: "SEM_DEV (Entwicklung)"
    host: '192.168.114.21'
    user: 'tdops'
    password: 'tdops'
    schema: 'SEM_DEV_MET_BASE'

  - id: sem_dev01
    label: "SEM_DEV01"
    host: '192.168.114.21'
    user: 'tdops'
    password: 'tdops'
    schema: 'SEM_DEV01_MET_BASE'

  - id: sem_tst
    label: "SEM_TST (Test)"
    host: '192.168.114.21'
    user: 'tdops'
    password: 'tdops'
    schema: 'SEM_TST_MET_BASE'

# Environment-ID, die verwendet wird, wenn das Frontend keinen (oder einen
# unbekannten) X-Env-Id-Header schickt.
default: mdp01
