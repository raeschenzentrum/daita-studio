INSERT INTO ${FK_KEY_DATABASE}.${FK_KEY_TABLE} (
    SURROGATE_KEY, NATURAL_KEY_VALUE, NATURAL_KEY_DOMAIN, NATURAL_KEY_HASH,
    CREATED_TIMESTAMP, CREATED_BY
)
SELECT
    COALESCE((SELECT MAX(SURROGATE_KEY) FROM ${FK_KEY_DATABASE}.${FK_KEY_TABLE}), 0)
        + DENSE_RANK() OVER (ORDER BY src.natural_key),
    src.natural_key,
    '${FK_DOMAIN}',
    HASHROW(src.natural_key),
    CURRENT_TIMESTAMP(6),
    'LATE_ARRIVING_JOB_${ETL_JOB_ID}'
FROM (
    SELECT DISTINCT x.natural_key FROM (
        ${FK_NATURAL_KEYS}
    ) x
    WHERE x.natural_key NOT IN (
        SELECT k.NATURAL_KEY_VALUE FROM ${FK_KEY_DATABASE}.${FK_KEY_TABLE} k
        WHERE k.NATURAL_KEY_DOMAIN = '${FK_DOMAIN}'
    )
) src
